# Bu dosyayı .env olarak kopyalamayın ve depoya yüklemeyin; değerleri barındırma panelindeki
# "Environment Variables" bölümüne girin. Yerelde denemek için: export DEĞİŞKEN=değer

# Sitenin gerçek adresi (canonical, sitemap, Open Graph için)
SITE_URL=https://ancvertex.com

# İletişim formu e-posta gönderimi (Resend: https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=        # taleplerin geleceği kendi e-posta adresin
CONTACT_FROM_EMAIL=      # Resend'de doğruladığın alan adından bir adres, ör. "ANC Vertex <form@senin-alan-adin.com>"

# İsteğe bağlı: Cloudflare Turnstile spam koruması
TURNSTILE_SITE_KEY=      # build sırasında okunur (genel anahtar)
TURNSTILE_SECRET=        # yalnızca sunucuda (gizli anahtar)
